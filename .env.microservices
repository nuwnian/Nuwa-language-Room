# Nuwa Language Room - Microservices Environment Variables

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production

# Supabase Configuration
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key

# Redis Configuration (if using external Redis)
REDIS_URL=redis://localhost:6379

# API Gateway Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# Monitoring (optional)
GRAFANA_PASSWORD=secure-grafana-password

# Development/Production Mode
NODE_ENV=development
ENV=development

# Service-specific ports (for development)
API_GATEWAY_PORT=80
USER_SERVICE_PORT=3001
CHAT_SERVICE_PORT=3002
AI_SERVICE_PORT=8001
NOTIFICATION_SERVICE_PORT=3003
FRONTEND_PORT=3000
REDIS_PORT=6379

# Database URLs (if using separate databases)
USER_DATABASE_URL=postgresql://...
CHAT_DATABASE_URL=postgresql://...

# External Service URLs (for inter-service communication)
USER_SERVICE_URL=http://user-service:3001
CHAT_SERVICE_URL=http://chat-service:3002
AI_SERVICE_URL=http://ai-service:8001
NOTIFICATION_SERVICE_URL=http://notification-service:3003

# Email Service (for notifications, optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# File Storage (if using cloud storage)
AWS_S3_BUCKET=nuwa-file-storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# Health Check Intervals (seconds)
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3